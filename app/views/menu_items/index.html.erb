<div class="page-header">
  <h1 class="page-title">Menu items</h1>
  <%= link_to "New menu item", new_menu_item_path, class: "btn-dark" %>
</div>

<div class="table-wrap">
  <table class="table">
    <thead>
      <tr>
        <th class="w-16">ID</th>
        <th>Name</th>
        <th class="text-right">Price</th>
        <th class="text-right">Stock</th>
        <th>Status</th>
        <th class="w-40"></th>
      </tr>
    </thead>
    <tbody>
      <% @menu_items.each do |menu_item| %>
        <tr>
          <td><%= menu_item.id %></td>
          <td><%= link_to menu_item.name, menu_item_path(menu_item), class: "link" %></td>
          <td class="text-right"><%= baht(menu_item.price) %></td>
          <td class="text-right"><%= menu_item.inventory_count %></td>
          <td>
            <span class="<%= menu_item.active ? "badge-ok" : "badge-neutral" %>">
              <%= menu_item.active ? "Active" : "Inactive" %>
            </span>
          </td>
          <td>
            <div class="flex justify-end gap-1">
              <%= link_to "Edit", edit_menu_item_path(menu_item), class: "btn-ghost btn-sm" %>
              <%= button_to "Delete", menu_item, method: :delete, class: "btn-danger btn-sm",
                    form: { data: { turbo_confirm: "Delete #{menu_item.name}?" } } %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
