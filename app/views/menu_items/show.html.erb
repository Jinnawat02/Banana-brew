<% previous_path = request.referer ? URI(request.referer).path : nil %>

<div class="flex flex-wrap items-center justify-between gap-3">
  <%= link_to previous_path == "/" ? "Back to menu" : "Back to previous", previous_path, class: "link text-sm" %>

  <% if authenticated? && Current.user.has_role?(:admin) %>
    <div class="flex gap-2">
      <%= link_to "Edit", edit_menu_item_path(@menu_item), class: "btn-secondary btn-sm" %>
      <%= button_to "Delete", @menu_item, method: :delete, class: "btn-danger btn-sm",
            form: { data: { turbo_confirm: "Delete #{@menu_item.name}?" } } %>
    </div>
  <% end %>
</div>

<div class="mt-6 grid gap-8 md:grid-cols-2">
  <div class="grid aspect-[4/3] place-items-center overflow-hidden rounded-2xl bg-banana/25 text-mocha">
    <%= menu_item_image(@menu_item) %>
  </div>
  <div>
    <p class="font-display text-sm text-mocha"><%= @menu_item.category.name %></p>
    <h1 class="page-title mt-1"><%= @menu_item.name %></h1>

    <div class="mt-3 flex items-center gap-3">
      <span class="price-tag text-xl"><%= baht(@menu_item.price) %></span>
      <% if @menu_item.inventory_count.positive? %>
        <span class="badge-ok"><%= @menu_item.inventory_count %> in stock</span>
      <% else %>
        <span class="badge-danger">Out of stock</span>
      <% end %>
    </div>

    <% if @menu_item.description.present? %>
      <div class="mt-5 text-sm text-mocha"><%= @menu_item.description %></div>
    <% end %>

    <%= button_to "Add to cart", cart_items_path, params: { menu_item: @menu_item }, class: "btn-primary mt-6" %>
  </div>
</div>
