<% previous_path = request.referer ? URI(request.referer).path : nil %>

<div>
  <div class="flex justify-between">
    <u><%= link_to 'Back to menu page', previous_path == '/' ? previous_path : menu_items_path %></u>
    
    <% if authenticated? %>
      <div class="flex items-right gap-4">
        <u><%= link_to 'Edit', edit_menu_item_path %></u> 
        <u><%= link_to 'Delete', menu_item_path(@menu_item.id), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %></u> 
      </div>
    <% end %>
  </div>

  <div class="mt-8">
    <div class="grid aspect-[4/3] place-items-center rounded-2xl bg-banana/25 text-mocha"><svg class="size-16"><use href="#cup"></use></svg></div>

    <div class="mt-3">
      <p class="font-display text-sm"><%= @menu_item.category.name %></p>

      <h3 class="font-display text-3xl font-medium"><%= @menu_item.name %></h3>

      <div class="mt-3 flex items-baseline gap-3">
        <span class="rounded-md bg-banana px-3 py-1 font-display text-xl text-banana-ink">฿<%= @menu_item.price %></span>
        <span class="rounded-full bg-ok-soft px-2.5 py-1 text-xs font-medium text-ok w-50"><%= @menu_item.inventory_count %></span>
      </div>

      <% if @menu_item.description.present? %>
        <div class="mt-3 text-sm text-mocha"><%= @menu_item.description %></div>
      <% end %>
    </div>
  </div>
</div>
