<%= form_with model: menu_item, class: "card mt-6 space-y-5" do |form| %>
  <%= render "shared/form_errors", record: menu_item %>

  <div>
    <%= form.label :name, class: "label" %>
    <%= form.text_field :name, class: "input" %>
  </div>

  <div>
    <%= form.label :category_id, "Category", class: "label" %>
    <%= form.collection_select :category_id, categories, :id, :name, { prompt: "Select a category" }, class: "input" %>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= form.label :price, class: "label" %>
      <%= form.number_field :price, step: 0.01, min: 0, class: "input" %>
    </div>

    <div>
      <%= form.label :inventory_count, "Stock", class: "label" %>
      <%= form.number_field :inventory_count, min: 0, class: "input" %>
    </div>
  </div>

  <fieldset>
    <legend class="label">Status</legend>
    <div class="flex gap-5 text-sm">
      <label class="flex items-center gap-2">
        <%= form.radio_button :active, true %> Active
      </label>
      <label class="flex items-center gap-2">
        <%= form.radio_button :active, false %> Inactive
      </label>
    </div>
  </fieldset>

  <div data-controller="image-preview">
    <%= form.label :image, class: "label" %>

    <% saved_image = menu_item.image if menu_item.image.attached? && menu_item.image.persisted? %>
    <%= tag.img src: (url_for(saved_image) if saved_image), alt: "Image preview", hidden: saved_image.nil?,
          class: "mb-3 aspect-[4/3] w-48 rounded-lg object-cover",
          data: { image_preview_target: "preview" } %>

    <%= form.file_field :image, accept: MenuItem::IMAGE_TYPES.join(","), class: "input",
          data: { image_preview_target: "input", action: "change->image-preview#show" } %>
    <p class="hint">JPEG, PNG or WebP, up to 5 MB. Leave empty to keep the current image.</p>
  </div>


  <div>
    <%= form.label :description, class: "label" %>
    <div class="rich-text-field">
      <%= form.rich_textarea :description, placeholder: "Taste notes, ingredients, allergens…" %>
    </div>
    <p class="hint">Use the toolbar for bold text, lists and links.</p>
  </div>

  <div class="flex justify-end gap-2">
    <%= link_to "Cancel", menu_item.persisted? ? menu_item_path(menu_item) : menu_items_path, class: "btn-secondary" %>
    <%= form.submit class: "btn-primary" %>
  </div>
<% end %>
