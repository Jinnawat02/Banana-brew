<li>
  <%= link_to menu_item_path(item), class: "group block" do %>
    <div class="grid aspect-[4/3] place-items-center rounded-2xl bg-banana/25 text-mocha"><svg class="size-16"><use href="#cup"></use></svg></div>
    <div class="mt-3 flex items-baseline justify-between gap-3">
      <h2 class="text-lg group-hover:underline"><%= item.name %></h2>
      <span class="price-tag"><%= baht(item.price) %></span>
    </div>
    <p class="mt-1 text-sm text-mocha"><%= item.description.to_plain_text.truncate(150) %></p>
  <% end %>
</li>
