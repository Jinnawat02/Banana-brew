<% cart_title = current_cart.empty? ? "Cart" : "Cart (#{current_cart.size})" %>

<nav class="bg-roast text-[#fdf6ea]">
  <div class="mx-auto flex max-w-6xl items-center gap-4 px-4 py-3">
    <%= link_to "Banana Brew", root_path, class: "font-display text-xl" %>

    <div class="ml-auto flex items-center gap-2 text-sm">
      <%= link_to cart_title, cart_path, class: "nav-cta" %>

      <% if authenticated? %>
        <%= link_to "My orders", orders_path, class: "nav-link" %>
        <%= button_to "Logout", session_path, method: :delete, class: "nav-link cursor-pointer" %>
      <% else %>
        <%= link_to "Login", new_session_path, class: "nav-link" %>
      <% end %>
    </div>
  </div>
</nav>
