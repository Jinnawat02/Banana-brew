<% base     = "shrink-0 rounded-full px-4 py-2 text-sm" %>
<% active   = "bg-espresso text-roast" %>
<% inactive = "border border-line hover:bg-paper" %>

<div class="mt-6 flex gap-2 overflow-x-auto pb-1">
  <%= link_to 'All', root_path, 
  class: class_names(base, selected.blank? ? active : inactive) %>

  <% categories.each do |category| %>
    <%= link_to category.name, root_path(category: category), 
          class: class_names(base, category_selected?(category, selected) ? active : inactive) %>
  <% end %>
</div>