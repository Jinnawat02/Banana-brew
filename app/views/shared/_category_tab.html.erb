<div class="mt-6 flex gap-2 overflow-x-auto pb-1">
  <%= link_to "All", root_path, class: selected.blank? ? "chip-active" : "chip" %>

  <% categories.each do |category| %>
    <%= link_to category.name, root_path(category: category),
          class: category_selected?(category, selected) ? "chip-active" : "chip" %>
  <% end %>
</div>
