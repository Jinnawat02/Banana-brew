<% if @lines.empty? %>
  <div class="flex flex-col justify-center items-center h-100">
    Empty cart
    <%= link_to "Back to home page", root_path, class: "underline" %>
  </div>
<% else %>
  <div class="flex flex-col justify-center items-start m-2 p-4 rounded-sm bg-mocha">
    <% @lines.each do |line| %>
      <div class="my-2 text-crema text-xl">
        <%= line.menu_item.name %> | <%= number_to_currency(line.menu_item.price, unit: "฿") %> | <%= line.quantity %> | total: <%= number_to_currency(line.sub_total, unit: "฿") %>
      </div>
    <% end %>

    <div class="self-end m-2 p-2 border border-black rounded-sm">
      <% if authenticated? %>
        <%= button_to "Place order", checkout_path, form: { data: { turbo_confirm: "Place this order?" } } %>
      <% else %>
        <%= link_to "Log in to place order", new_session_path %>
      <% end %>
    </div>
  </div>

<% end %>
