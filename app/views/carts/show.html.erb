<h1 class="page-title mb-6">Your cart</h1>

<% if @lines.empty? %>
  <div class="empty-state">
    <p>Your cart is empty.</p>
    <%= link_to "Browse menu", root_path, class: "btn-primary mt-4" %>
  </div>
<% else %>
  <div class="card">
    <ul>
      <% @lines.each do |line| %>
        <li class="flex flex-wrap items-center gap-3 border-b border-line py-4 first:pt-0">
          <div class="flex-grow">
            <%= link_to line.menu_item.name, menu_item_path(line.menu_item), class: "font-medium hover:underline" %>
            <p class="text-sm text-mocha"><%= baht(line.menu_item.price) %> each</p>
          </div>

          <%= form_with url: cart_item_path(line.menu_item), method: :patch, class: "flex items-center gap-2" do |f| %>
            <%= f.number_field :quantity, value: line.quantity, min: 0, class: "input w-20 py-1.5",
                  aria: { label: "Quantity of #{line.menu_item.name}" } %>
            <%= f.submit "Update", class: "btn-secondary btn-sm" %>
          <% end %>

          <span class="w-24 text-right font-medium"><%= baht(line.sub_total) %></span>

          <%= button_to "Remove", cart_item_path(line.menu_item), method: :delete, class: "btn-danger btn-sm" %>
        </li>
      <% end %>
    </ul>

    <div class="mt-5 flex flex-wrap items-center justify-between gap-3">
      <p class="text-lg font-medium">Total: <%= baht(@lines.sum(&:sub_total)) %></p>

      <% if authenticated? %>
        <%= button_to "Place order", checkout_path, class: "btn-primary",
              form: { data: { turbo_confirm: "Place this order?" } } %>
      <% else %>
        <%= link_to "Log in to place order", new_session_path, class: "btn-dark" %>
      <% end %>
    </div>
  </div>
<% end %>
