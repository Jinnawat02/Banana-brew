<div class="page-header">
  <h1 class="page-title">Categories</h1>
  <%= link_to "New category", new_category_path, class: "btn-dark" %>
</div>

<div class="table-wrap">
  <table class="table">
    <thead>
      <tr>
        <th class="w-16">ID</th>
        <th>Name</th>
        <th class="w-40"></th>
      </tr>
    </thead>
    <tbody>
      <% @categories.each do |category| %>
        <tr>
          <td><%= category.id %></td>
          <td><%= category.name %></td>
          <td>
            <div class="flex justify-end gap-1">
              <%= link_to "Edit", edit_category_path(category), class: "btn-ghost btn-sm" %>
              <%= button_to "Delete", category, method: :delete, class: "btn-danger btn-sm",
                    form: { data: { turbo_confirm: "Delete #{category.name}?" } } %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
