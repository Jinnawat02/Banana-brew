<% if authenticated? && Current.user.has_role?(:admin) %>
  <div class="flex justify-end gap-2">
    <%= link_to "Menu items", menu_items_path, class: "btn-secondary btn-sm" %>
    <%= link_to "Categories", categories_path, class: "btn-secondary btn-sm" %>
  </div>
<% end %>

<%= render "shared/category_tab", categories: @categories, selected: params[:category] %>

<ul class="mt-8 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
  <% @menu_items.each do |item| %>
    <%= render "shared/menu_item", item: item %>
  <% end %>
</ul>
