<%= link_to "← All orders", orders_path, class: "link text-sm" %>

<div class="page-header mt-4">
  <h1 class="page-title">Order #<%= @order.id %></h1>
  <span class="badge-neutral"><%= @order.status %></span>
</div>

<div class="card">
  <p class="text-sm text-mocha">Placed <%= l @order.created_at, format: :long %></p>

  <ul class="mt-3">
    <% @order.order_items.each do |item| %>
      <li class="flex items-center gap-3 border-t border-line py-3">
        <span class="flex-grow font-medium"><%= item.menu_item.name %></span>
        <span class="text-sm text-mocha"><%= item.quantity %> × <%= baht(item.unit_price) %></span>
        <span class="w-24 text-right font-medium"><%= baht(item.quantity * item.unit_price) %></span>
      </li>
    <% end %>
  </ul>

  <p class="mt-3 border-t border-line pt-4 text-right text-lg font-medium">Total: <%= baht(@order.total) %></p>
</div>
